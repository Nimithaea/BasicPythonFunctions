#Print numbers greater than 20
number=list(map(int,input('Enter the number :').split()))
def greater_number(number):
    greater=[]
    for i in number:
        if i>20:
            greater.append(i)
    print('Greater Numbers are', greater)
greater_number(number)

# #Write a function to print numbers LESS than 20.
def smaller_number(number):
    smaller=[]
    for i in number:
        if i<=20:
            smaller.append(i)
    print('The smaller numbers are :',smaller)
smaller_number(number)

#Print numbers divisible by 5
def divisible(number):
    divisible=[]
    for i in number:
        if i%5==0:
            divisible.append(i)
    print('The numbers divisible by 5 are : ', divisible)
divisible(number) 